rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    match /communityPosts/{postId} {
      // Visitors can only read posts approved by the admin.
      allow read: if resource.data.status == "approved" || isAdmin();

      // Public submissions must be authenticated anonymously and always start pending.
      allow create: if request.auth != null
        && request.resource.data.status == "pending"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.story is string
        && request.resource.data.story.size() <= 3000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40;

      // Only the configured admin can approve, edit or delete posts.
      allow update, delete: if isAdmin();
    }
  }
}
