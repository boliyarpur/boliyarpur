rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function post(postId) {
      return firestore.get(/databases/(default)/documents/communityPosts/$(postId));
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    match /community/{postId}/{uid}/{fileName} {
      // A visitor can read media only after its post has been approved.
      allow read: if isAdmin() || (
        postId != ""
        && post(postId).data.status == "approved"
      );

      // Only the owner of the pending post can upload its media.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && post(postId).data.uid == request.auth.uid
        && post(postId).data.status == "pending"
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)'));

      allow update, delete: if isAdmin();
    }
  }
}