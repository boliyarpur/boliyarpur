rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "mdtusher2345@gmail.com";
    }
    function approvedPost(postId) {
      return firestore.exists(/databases/(default)/documents/communityPosts/$(postId))
        && firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.status == "approved";
    }
    match /communityUploads/{uid}/{postId}/{fileName} {
      allow read: if isAdmin() || approvedPost(postId);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|video/(mp4|webm|quicktime))');
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}